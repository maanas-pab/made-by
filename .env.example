# Public site identity (defaults to madeby.vercel.app — change after buying a domain)
NEXT_PUBLIC_SITE_DOMAIN=madeby.vercel.app

# Cloud saving (optional but recommended for real users).
# Create a free Supabase project → run supabase/schema.sql → paste values here
# AND into Vercel Project Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
